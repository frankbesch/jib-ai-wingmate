# Every environment variable the code reads. Leave all empty to run offline.
# Parser API key for live mode; read by pipeline.py, heldout2/run_heldout2.py, and the mcp/ configs.
PULSE_API_KEY=
# Parser API base URL for live mode, no default in code; read by pipeline.py.
PULSE_BASE_URL=
# Hosted parser MCP server URL; read by mcp/.mcp.json, mcp/claude-desktop-config.json, and mcp/preflight.sh.
PARSER_MCP_URL=
# API key for the metered discriminative model in typed replays; read by typed/jev_backend.py.
TYPESAFE_API_KEY=
# Claude API key for the cost replay; read by typed/run-claude-api-cost.sh (anthropic SDK reads it too).
ANTHROPIC_API_KEY=
# Model id for the cost replay (default claude-fable-5-1); read by typed/run-claude-api-cost.sh.
MODEL=
# Spend cap in USD for the cost replay (default 15); read by typed/run-claude-api-cost.sh.
MAX_USD=
# Output token cap per call for the cost replay (default 4096); read by typed/run-claude-api-cost.sh.
MAX_TOKENS=
# Watchdog limit in seconds for the cost replay (default 1800); read by typed/run-claude-api-cost.sh.
WATCHDOG_SECS=
# Virtual environment path for the cost replay (default typed/.venv-claude-api); read by typed/run-claude-api-cost.sh.
VENV=
# Python interpreter for the typed redo runner (default python3); read by typed/run-typed-redo.sh.
PY=
# Stub sleep in seconds for --stub runs (default 3); read by typed/run-typed-redo.sh.
STUB_SLEEP=
# Stub request count for --stub runs (default 26); read by typed/run-typed-redo.sh.
STUB_REQUESTS=
# Stub cost bound in USD for --stub runs (default 0.002991); read by typed/run-typed-redo.sh.
STUB_BOUND=
# Seconds to wait for the sign-in check (default 30); read by heldout2/run-heldout2.sh.
HELDOUT2_AUTH_TIMEOUT=
# Codex CLI home folder (default ~/.codex); read by heldout2/run_heldout2.py.
CODEX_HOME=
# Extra folder to search for the IBM Plex fonts; read by docs/diagrams/quoin_readme.py.
QUOIN_FONTS=
# HTML-to-PDF render script used by audit/pack.py (not shipped).
AUDIT_RENDER_SH=
